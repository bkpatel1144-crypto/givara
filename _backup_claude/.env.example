# Copy to .env.local for local development, and add the same variables in
# Vercel → Project → Settings → Environment Variables for deployments.

# WhatsApp enquiry number in international format, digits only (no +, spaces or dashes).
# The floating WhatsApp button is hidden until this is set.
VITE_WHATSAPP_NUMBER=

# Market shown on a shopper's first visit: US, UK, EU, AE, AU or IN (default US).
VITE_DEFAULT_MARKET=US

# Where Givara's GLB ring models are hosted. Use /models for files in public/models,
# or a CDN URL (must allow CORS). Leave empty to show the ring illustration instead of 3D.
VITE_ASSET_BASE_URL=
